    ∃ oL', s'.finalOutcome l.address = some (.allocation oL') ∧
      oL'.owed left = oL.owed left + oV.amountAt 0 ∧
      oL'.owed right = oL.owed right + oV.amountAt 1 ∧
      oL'.find v.address = none ∧
      oL'.total = oL.total ∧
      s'.balances = s.balances ∧ s'.held = s.held ∧
