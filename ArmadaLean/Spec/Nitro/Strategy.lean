/-
  The spec statements of `ArmadaLean/Nitro/Strategy.lean` (`docs/spec-module-design.md`). One
  `Spec` definition per spec theorem, `∀ hypotheses, Claim conclusion`;
  `#check_spec_bindings` fails the build when
  a theorem's type is not definitionally equal to its definition. A change to this
  file is a change to an approved statement. Generated by `scripts/convert_spec.py`.
-/

import ArmadaLean.Nitro.Strategy
import ArmadaLean.SpecTools

open ArmadaLean.SpecTools (Claim)

namespace ArmadaLean.Nitro

variable {E : Type} [DecidableEq E]

/-- Two calls peel off a `RoundSeq` one at a time, in whichever order the
    adversary front-runs them (Nitro:540-542): `pending = [opA, opB]` splits
    at a `land` step either on `opA` (leaving `[opB]` still pending) or on
    `opB` (leaving `[opA]`), with ordinary adversary play (`tick`/`other`)
    before that first `land` — `peel_split`'s own split, specialized to a
    two-element pending list, which has only those two positions.
    `satp_intermediary_before_round2`'s two-call reaction peels through
    this, independently of which of its two calls the adversary lands
    first.

    Every state: proved for every state of its type, with no reachability hypothesis; a statement over every state is stronger than one over the reachable states (reason generated by scripts/convert_spec.py at cutover: scripts/reach-exempt.tsv had no row). -/
def Threat.RoundSeq.Spec.peel_two : Prop :=
  ∀ {apps : Apps E} {p : Participant} {T : Threat E p} {t : Time}
    (opA opB : Op E) (n0 n3 : NetworkState E p)
    (hseq : Threat.RoundSeq apps T t [opA, opB] n0 n3),
    Claim <|
    (∃ n1, Threat.RoundSeq apps T t [] n0 n1 ∧
      Threat.RoundSeq apps T t [opB] (n1.applyAdv apps (.land opA)) n3) ∨
    (∃ n1, Threat.RoundSeq apps T t [] n0 n1 ∧
      Threat.RoundSeq apps T t [opA] (n1.applyAdv apps (.land opB)) n3)

omit [DecidableEq E] in
/-- D7: a received signed state is held as it
    is, its voucher signatures (SATP:630-637, SATP:703) travelling with it
    (`NetworkState.Holds`'s second clause).

    Every state: proved for every state of its type, with no reachability hypothesis; a statement over every state is stronger than one over the reachable states (reason generated by scripts/convert_spec.py at cutover: scripts/reach-exempt.tsv had no row). -/
def Spec.holds_of_mem_received : Prop :=
  ∀ {p : Participant} {net : NetworkState E p} {ss : SignedState E}
    (h : ss ∈ net.received),
    Claim <|
    net.Holds ss

end ArmadaLean.Nitro

#check_spec_bindings
