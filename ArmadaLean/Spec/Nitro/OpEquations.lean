/-
  The spec statements of `ArmadaLean/Nitro/OpEquations.lean` (`docs/spec-module-design.md`). One
  `Spec` definition per spec theorem, `∀ hypotheses, Claim conclusion`;
  `#check_spec_bindings` fails the build when
  a theorem's type is not definitionally equal to its definition. A change to this
  file is a change to an approved statement. Generated by `scripts/convert_spec.py`.
-/

import ArmadaLean.Nitro.OpEquations
import ArmadaLean.SpecTools

open ArmadaLean.SpecTools (Claim)

namespace ArmadaLean.Nitro

variable {E : Type} [DecidableEq E]

namespace Adjudicator

/-- The `deposit` equation. go-nitro MultiAssetHolder.sol:38-64 `deposit`.

    Every state: an operation equation states what `apply` does in every state of its type; the adversary may submit any call in any state (armada-laconic docs/process.md R.2). -/
def Spec.apply_deposit_equation : Prop :=
  ∀ (apps : Apps E) (caller : Participant) (a : Address E)
    (expectedHeld x : Coins) (s : Adjudicator E),
    Claim <|
    s.apply apps caller (.deposit a expectedHeld x) =
      if h : s.DepositPre a expectedHeld then some (s.depositEffect expectedHeld ⟨a, h⟩ x)
      else none

/-- The `transfer` equation. go-nitro MultiAssetHolder.sol:75-110 `transfer`.

    Every state: an operation equation states what `apply` does in every state of its type; the adversary may submit any call in any state (armada-laconic docs/process.md R.2). -/
def Spec.apply_transfer_equation : Prop :=
  ∀ (apps : Apps E) (caller : Participant) (a : FixedPart)
    (b : Address E) (s : Adjudicator E),
    Claim <|
    s.apply apps caller (.transfer a b) =
      if h : s.TransferPre a b then some (s.transferEffect b ⟨a, h⟩) else none

