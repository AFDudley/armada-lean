/-- The `tick` equation. go-nitro StatusManager.sol:17-30 `_mode` reads `block.timestamp`;
    the clock always moves.

    Every state: an operation equation states what `apply` does in every state of its type; the adversary may submit any call in any state (armada-laconic docs/process.md R.2). -/
def Spec.apply_tick_equation : Prop :=
  ∀ (apps : Apps E) (caller : Participant) (dt : Time)
    (s : Adjudicator E),
    Claim <|
    s.apply apps caller (.tick dt) =
      if h : s.TickPre dt then some (s.tickEffect ⟨dt, h⟩) else none

end Adjudicator

