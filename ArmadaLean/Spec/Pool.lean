import ArmadaLean.Pool
import ArmadaLean.SpecTools

open ArmadaLean.SpecTools (Claim)

namespace ArmadaLean

/-- **The deployment fixes the treasury address.** No step changes `treasury` (operator
    ruling 2026-11-06).

    Every state: a case split on `Step`; no constructor writes `treasury`. -/
def Spec.step_treasury : Prop :=
  ∀ {s s' : PoolState} (h : Step s s'),
    Claim <|
    s'.treasury = s.treasury

end ArmadaLean

#check_spec_bindings
