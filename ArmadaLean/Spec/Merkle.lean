/-
  The spec statements of `ArmadaLean/Merkle.lean` (`docs/spec-module-design.md`). One
  `Spec` definition per spec theorem, `∀ hypotheses, Claim conclusion`;
  `#check_spec_bindings` fails the build when
  a theorem's type is not definitionally equal to its definition. A change to this
  file is a change to an approved statement. Generated by `scripts/convert_spec.py`.
-/

import ArmadaLean.Merkle
import ArmadaLean.SpecTools

open ArmadaLean.SpecTools (Claim)

namespace ArmadaLean

/--
A Merkle membership proof binds exactly one leaf to the root (Poseidon collision
resistance, by construction — `ArmadaLean.Poseidon`). Together with the on-chain root
check (Transact.circom:95), a prover cannot move a proof to a different commitment:
any two leaves yielding the same computed root along the same path are equal. -/
def Spec.merkleRoot_inj_leaf : Prop :=
  ∀ (path : List (Term × Bool)) {l₁ l₂ : Term}
    (h : merkleRoot l₁ path = merkleRoot l₂ path),
    Claim <|
    l₁ = l₂

/-- `treePath_correct` for a leaf that exists: if position `i` of `leaves` holds `leaf`,
    the path from `leaf` reconstructs the tree's root. The form that a pool theorem
    states, with no default value (audit finding P-8). -/
def Spec.treePath_correct_of_getElem? : Prop :=
  ∀ (d : Nat) (leaves : List Term) (i : Nat)
    (hi : i < 2 ^ d) {leaf : Term} (hleaf : leaves[i]? = some leaf),
    Claim <|
    merkleRoot leaf (treePath d leaves i) = treeRoot d leaves

end ArmadaLean

#check_spec_bindings
