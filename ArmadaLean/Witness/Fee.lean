/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/Fee.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Spec.Fee
import ArmadaLean.SpecTools
import ArmadaLean.Witness.CircuitValues

open ArmadaLean.Witness.CircuitValues

/-- The witness of `Spec.fee_monotone`: `feeRatio0`, `a = 0 ≤ b = 1`. -/
theorem ArmadaLean.Spec.fee_monotone.witness : spec_premise% ArmadaLean.Spec.fee_monotone := by
  refine ⟨feeRatio0, 0, 1, by decide, trivial⟩

/-- The witness of `Spec.fee_zero_below_threshold`: `feeRatio0.num = 0`, so
    `amount * 0 < 1` holds for every `amount`. -/
theorem ArmadaLean.Spec.fee_zero_below_threshold.witness : spec_premise% ArmadaLean.Spec.fee_zero_below_threshold := by
  refine ⟨feeRatio0, 0, by decide, trivial⟩

/-- The witness of `Spec.shieldBase_pos`: `x = 1`. -/
theorem ArmadaLean.Spec.shieldBase_pos.witness : spec_premise% ArmadaLean.Spec.shieldBase_pos := by
  refine ⟨feeRatio0, 1, by decide, trivial⟩
