/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/Nitro/Strategy.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Nitro.NonVacuity
import ArmadaLean.Spec.Nitro.Strategy
import ArmadaLean.SpecTools

open ArmadaLean.Nitro ArmadaLean.Nitro.NonVacuity

/-- The witness of `ArmadaLean.Nitro.Threat.RoundSeq.Spec.peel_two`: two
    transfers, landed via `Threat.RoundSeq.landAll`. -/
theorem ArmadaLean.Nitro.Threat.RoundSeq.Spec.peel_two.witness : spec_premise% ArmadaLean.Nitro.Threat.RoundSeq.Spec.peel_two := by
  obtain ⟨net', hseq, -⟩ := Threat.RoundSeq.landAll apps0 (turboT p0) netF.chain.now
    [Op.transfer c1 d0, Op.transfer c1 d1]
    (fun op hop dt => by
      simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at hop
      rcases hop with rfl | rfl <;> intro h <;> cases h)
    netF
  refine ⟨Nat, inferInstance, apps0, p0, turboT p0, netF.chain.now, Op.transfer c1 d0,
    Op.transfer c1 d1, netF, net', hseq, trivial⟩

/-- The witness of `ArmadaLean.Nitro.Spec.holds_of_mem_received`: the one
    entry of `netE`'s own received list. -/
theorem ArmadaLean.Nitro.Spec.holds_of_mem_received.witness : spec_premise% ArmadaLean.Nitro.Spec.holds_of_mem_received := by
  refine ⟨Nat, p0, netE, ⟨V0r, [p0, q0]⟩, List.mem_cons_self, trivial⟩
