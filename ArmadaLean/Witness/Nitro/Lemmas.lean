/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/Nitro/Lemmas.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Nitro.NonVacuity
import ArmadaLean.Spec.Nitro.Lemmas
import ArmadaLean.SpecTools

open ArmadaLean.Nitro ArmadaLean.Nitro.NonVacuity

/-- The witness of `ArmadaLean.Nitro.Balances.Spec.get_of_forall_ne`. -/
theorem ArmadaLean.Nitro.Balances.Spec.get_of_forall_ne.witness : spec_premise% ArmadaLean.Nitro.Balances.Spec.get_of_forall_ne := by
  refine ⟨Nat, inferInstance, ([] : Balances Nat), d0, fun e h => absurd h List.not_mem_nil, trivial⟩

/-- The witness of `ArmadaLean.Nitro.Allocation.Spec.payout_getElem?`. -/
theorem ArmadaLean.Nitro.Allocation.Spec.payout_getElem?.witness : spec_premise% ArmadaLean.Nitro.Allocation.Spec.payout_getElem? := by
  refine ⟨Nat, 1, o1, 0, alloc d0 1, by decide, trivial⟩

/-- The witness of `ArmadaLean.Nitro.Allocation.Spec.cover_pay`: `og = []` (so
    `hcov` holds no matter what `hg` bounds), `op = op' = [alloc d0 5, alloc d1 3]`
    (so `hop` is `le_refl`), `hg = 0`, `b = c = d0`. -/
theorem ArmadaLean.Nitro.Allocation.Spec.cover_pay.witness : spec_premise% ArmadaLean.Nitro.Allocation.Spec.cover_pay := by
  refine ⟨Nat, inferInstance, ([] : Allocation Nat), [alloc d0 5, alloc d1 3],
    [alloc d0 5, alloc d1 3], 0, fun b _ => ?_, d0, fun b => le_refl _, d0, by decide, trivial⟩
  have h : Allocation.dueBefore ([] : Allocation Nat) b + Allocation.owed ([] : Allocation Nat) b = 0 := rfl
  rw [h]

/-- The witness of `ArmadaLean.Nitro.Adjudicator.Spec.finalizedWith_apply`: a
    `tick` on the already-finalized `sCon`. -/
theorem ArmadaLean.Nitro.Adjudicator.Spec.finalizedWith_apply.witness : spec_premise% ArmadaLean.Nitro.Adjudicator.Spec.finalizedWith_apply := by
  refine ⟨Nat, inferInstance, apps0, p0, Op.tick 1, sCon, sCon.tick 1, rfl, c1, .allocation o1,
    by decide, trivial⟩

/-- The witness of `ArmadaLean.Nitro.Adjudicator.Spec.finalizedWith_stable`: the
    reflexive zero-step case on `sCon`. -/
theorem ArmadaLean.Nitro.Adjudicator.Spec.finalizedWith_stable.witness : spec_premise% ArmadaLean.Nitro.Adjudicator.Spec.finalizedWith_stable := by
  refine ⟨Nat, inferInstance, apps0, sCon, sCon, .refl, c1, .allocation o1, by decide, trivial⟩

/-- The witness of `ArmadaLean.Nitro.Adjudicator.Spec.transfer_effect`: `sCon`'s
    transfer to `d0`. -/
theorem ArmadaLean.Nitro.Adjudicator.Spec.transfer_effect.witness : spec_premise% ArmadaLean.Nitro.Adjudicator.Spec.transfer_effect := by
  refine ⟨Nat, inferInstance, sCon, _, c1, d0, rfl, trivial⟩
