/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/Nitro/Reachable.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Nitro.NonVacuity
import ArmadaLean.Spec.Nitro.Reachable
import ArmadaLean.SpecTools

open ArmadaLean.Nitro ArmadaLean.Nitro.NonVacuity

/-- The witness of `ArmadaLean.Nitro.Reachable.Spec.balances_virtual_zero`: the
    genesis chain, reached in zero steps, and the virtual channel `cV`. -/
theorem ArmadaLean.Nitro.Reachable.Spec.balances_virtual_zero.witness : spec_premise% ArmadaLean.Nitro.Reachable.Spec.balances_virtual_zero := by
  refine ⟨Nat, inferInstance, apps0, ⟨g0, Nitro.chain_reachable_iff.mpr .refl⟩, cV, rfl, trivial⟩

/-- The witness of `Nitro.Spec.participant_received_unforged`: the reachable
    network state `netF`, under the canonical threat's bounds. -/
theorem ArmadaLean.Nitro.Spec.participant_received_unforged.witness : spec_premise% ArmadaLean.Nitro.Spec.participant_received_unforged := by
  refine ⟨Nat, inferInstance, apps0, p0, canon p0, (canon_ok apps0 p0).toBounds, ⟨netF, netF_reach⟩, trivial⟩
