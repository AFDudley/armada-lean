/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/Nullifier.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Spec.Nullifier
import ArmadaLean.SpecTools
import ArmadaLean.Witness.CircuitValues

open ArmadaLean.Witness.CircuitValues

/-- The witness of `Spec.distinct_leaves_distinct_nullifiers`: the empty leaf
    list, pairwise-distinct vacuously. -/
theorem ArmadaLean.Spec.distinct_leaves_distinct_nullifiers.witness :
    spec_premise% ArmadaLean.Spec.distinct_leaves_distinct_nullifiers := by
  refine ⟨t0, [], List.Pairwise.nil, trivial⟩
