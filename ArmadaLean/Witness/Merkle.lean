/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/Merkle.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Spec.Merkle
import ArmadaLean.SpecTools
import ArmadaLean.Witness.CircuitValues

open ArmadaLean.Witness.CircuitValues

/-- The witness of `Spec.merkleRoot_inj_leaf`: the empty path, `t0` against
    itself. -/
theorem ArmadaLean.Spec.merkleRoot_inj_leaf.witness : spec_premise% ArmadaLean.Spec.merkleRoot_inj_leaf := by
  refine ⟨[], t0, t0, rfl, trivial⟩

/-- The witness of `Spec.treePath_correct_of_getElem?`: depth `0`, the
    one-leaf list `[t0]`, position `0`. -/
theorem ArmadaLean.Spec.treePath_correct_of_getElem?.witness :
    spec_premise% ArmadaLean.Spec.treePath_correct_of_getElem? := by
  refine ⟨0, [t0], 0, by decide, t0, rfl, trivial⟩
