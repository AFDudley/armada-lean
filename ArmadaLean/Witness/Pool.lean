/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/Pool.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.PoolNonVacuity
import ArmadaLean.Spec.Pool
import ArmadaLean.SpecTools

open ArmadaLean.PoolNonVacuity (g0 r0 feeAdmin0)

/-- The witness of `Spec.step_treasury`: the fee admin's setter step from `g0`. -/
theorem ArmadaLean.Spec.step_treasury.witness : spec_premise% ArmadaLean.Spec.step_treasury := by
  exact ⟨g0, _, .setFeeRatio feeAdmin0 rfl r0, trivial⟩
