/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/PoolOwned.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.

  `owned_spend_can_happen` stays open: its hypothesis `hComplete : OwnedProofCompleteness`
  needs a concrete instance, and `hComplete.complete` is a proof of `∀ w pub,
  OwnedConstrained w pub → VerifyOwnedAccepts pub`. `VerifyOwnedAccepts` is an opaque
  axiom with no defining equation (`axiom VerifyOwnedAccepts : {N M : Nat} →
  TransactOwnedPublic N M → Prop`, `ArmadaLean.PoolOwned`), so this universal statement
  is not provable (`docs/spec-module-design.md` §5: "A hypothesis about an
  uninterpreted primitive … has no concrete proof, so its witness stays open").
  `ArmadaLean/PoolNonVacuity.lean`'s module comment records the same finding for the
  plain path's `EdDSAVerify`.
-/
import ArmadaLean.PoolNonVacuity
import ArmadaLean.Spec.PoolOwned
import ArmadaLean.SpecTools

/-- The witness of `Spec.owned_owner_binding`, from
    `ArmadaLean.PoolNonVacuity.owned_owner_binding.nonvacuity`. -/
theorem Spec.owned_owner_binding.witness : spec_premise% Spec.owned_owner_binding := by
  spec_witness ArmadaLean.PoolNonVacuity.owned_owner_binding.nonvacuity

/-- The witness of `Spec.owned_no_double_spend`, from
    `ArmadaLean.PoolNonVacuity.owned_no_double_spend.nonvacuity`. -/
theorem Spec.owned_no_double_spend.witness : spec_premise% Spec.owned_no_double_spend := by
  spec_witness ArmadaLean.PoolNonVacuity.owned_no_double_spend.nonvacuity

/-- The witness of `Spec.preimageOf_consistent`, from
    `ArmadaLean.PoolNonVacuity.preimageOf_consistent.nonvacuity`. -/
theorem Spec.preimageOf_consistent.witness : spec_premise% Spec.preimageOf_consistent := by
  spec_witness ArmadaLean.PoolNonVacuity.preimageOf_consistent.nonvacuity

/-- The witness of `Spec.owned_spend_can_happen`: open. Its hypothesis `hComplete :
    OwnedProofCompleteness` needs a concrete instance of `VerifyOwnedAccepts`
    completeness; see this file's module comment. -/
theorem Spec.owned_spend_can_happen.witness : spec_premise% Spec.owned_spend_can_happen := by
  sorry
