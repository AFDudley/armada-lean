/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/TransactOwned.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Spec.TransactOwned
import ArmadaLean.SpecTools
import ArmadaLean.Witness.CircuitValues

open ArmadaLean.Witness.CircuitValues

/-- The witness of `Spec.transactOwned_value_conserved`: `N = M = 0`, so
    every per-input and per-output field of `OwnedConstrained` is vacuous
    and the balance check is `fieldEq 0 0`, `rfl`. The owner is the address `0`. -/
theorem ArmadaLean.Spec.transactOwned_value_conserved.witness :
    spec_premise% ArmadaLean.Spec.transactOwned_value_conserved := by
  refine ⟨0, 0,
    ⟨token0, fun i => i.elim0, fun i => i.elim0, fun i => i.elim0, fun i => i.elim0,
      fun j => j.elim0, fun j => j.elim0⟩,
    ⟨t0, t0, fun i => i.elim0, fun j => j.elim0, ⟨0, by decide⟩⟩,
    by decide, by decide,
    ⟨fun i => i.elim0, fun i => i.elim0, fun j => j.elim0,
      fun i => i.elim0, fun j => j.elim0, rfl⟩,
    trivial⟩

/-- The witness of `Spec.commitment_owner_inj`: `t0` against itself, randomness
    `0`, value `0`. -/
theorem ArmadaLean.Spec.commitment_owner_inj.witness : spec_premise% ArmadaLean.Spec.commitment_owner_inj := by
  refine ⟨t0, t0, 0, 0, 0, token0, rfl, trivial⟩
