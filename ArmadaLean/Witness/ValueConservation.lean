/-
  The non-vacuity witnesses of the spec entries of `ArmadaLean/ValueConservation.lean` (`verification.md` §5a,
  `docs/spec-module-design.md`). Each witness proves `spec_premise%` of its entry:
  values exist for all binders and every hypothesis holds. A witness proved by
  `sorry` is open required work. Generated by `scripts/convert_spec.py`; an existing
  witness is kept on a re-run.
-/
import ArmadaLean.Spec.ValueConservation
import ArmadaLean.SpecTools

/-- The witness of `Spec.listSum_lt_p`: the empty list. -/
theorem ArmadaLean.Spec.listSum_lt_p.witness : spec_premise% ArmadaLean.Spec.listSum_lt_p := by
  refine ⟨[], by decide, fun v hv => absurd hv (List.not_mem_nil), trivial⟩

/-- The witness of `Spec.no_wraparound_minting`: the empty list on each side;
    `fieldEq 0 0` is `rfl`. -/
theorem ArmadaLean.Spec.no_wraparound_minting.witness : spec_premise% ArmadaLean.Spec.no_wraparound_minting := by
  refine ⟨[], [], by decide, by decide,
    fun v hv => absurd hv (List.not_mem_nil), fun v hv => absurd hv (List.not_mem_nil),
    rfl, trivial⟩
